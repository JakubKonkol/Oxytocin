{
  "name": "@oxytocin/markdown-preview",
  "version": "0.2.0",
  "description": "Live preview of Markdown (rendered) and code files (highlighted) next to the terminal",
  "license": "MIT",
  "private": true,
  "type": "module",
  "oxytocin": {
    "id": "oxytocin.markdown-preview",
    "displayName": "File Preview",
    "description": "Live preview of Markdown and code files next to the terminal or in the right sidebar — opened from terminal links and the Changes list.",
    "publisher": "oxytocin",
    "engine": "^0.1.4",
    "main": "dist/host.js",
    "activationEvents": [
      "onPanel:markdown.preview",
      "onCommand:markdown.openPreview"
    ],
    "permissions": [
      "projects.read",
      "fs.read-project"
    ],
    "contributes": {
      "panels": [
        {
          "type": "markdown.preview",
          "title": "Preview",
          "entry": "dist/views/preview.html",
          "singleton": false
        }
      ],
      "commands": [
        {
          "id": "markdown.openPreview",
          "title": "Markdown: Open Preview"
        }
      ],
      "fileOpeners": [
        {
          "id": "markdown.preview",
          "extensions": [
            ".md",
            ".markdown",
            ".mdx"
          ],
          "panelType": "markdown.preview",
          "title": "Open Preview",
          "default": true
        },
        {
          "id": "code.preview",
          "extensions": [
            ".ts",
            ".mts",
            ".cts",
            ".tsx",
            ".js",
            ".mjs",
            ".cjs",
            ".jsx",
            ".json",
            ".jsonc",
            ".json5",
            ".css",
            ".scss",
            ".html",
            ".htm",
            ".vue",
            ".svelte",
            ".xml",
            ".svg",
            ".csproj",
            ".fsproj",
            ".vbproj",
            ".props",
            ".targets",
            ".xaml",
            ".resx",
            ".config",
            ".plist",
            ".yml",
            ".yaml",
            ".toml",
            ".ini",
            ".cfg",
            ".conf",
            ".env",
            ".properties",
            ".editorconfig",
            ".py",
            ".pyi",
            ".cs",
            ".csx",
            ".go",
            ".rs",
            ".java",
            ".kt",
            ".kts",
            ".gradle",
            ".swift",
            ".php",
            ".rb",
            ".sh",
            ".bash",
            ".zsh",
            ".ps1",
            ".psm1",
            ".psd1",
            ".sql",
            ".c",
            ".h",
            ".cpp",
            ".cc",
            ".cxx",
            ".hpp",
            ".hh",
            ".diff",
            ".patch",
            ".txt",
            ".log",
            ".csv",
            ".tsv",
            ".lock",
            ".gitignore",
            ".dockerignore",
            ".gitattributes",
            ".npmrc",
            ".nvmrc",
            ".sln",
            ".slnx",
            ".graphql",
            ".gql",
            ".proto",
            ".tf",
            ".dart",
            ".lua",
            ".r",
            ".scala",
            ".ex",
            ".exs",
            ".erl",
            ".hs",
            ".clj",
            ".less",
            ".sass",
            ".styl",
            ".astro",
            ".razor",
            ".cshtml",
            ".vb",
            ".fs",
            ".bat",
            ".cmd"
          ],
          "panelType": "markdown.preview",
          "title": "Open Preview",
          "default": true
        }
      ]
    }
  }
}
