{
  "name": "@oxytocin/code-map-visualizer",
  "version": "0.2.0",
  "description": "Explore bounded local code graphs and open verified source locations",
  "license": "MIT",
  "private": true,
  "type": "module",
  "oxytocin": {
    "id": "oxytocin.code-map-visualizer",
    "displayName": "Code Map Visualizer",
    "description": "Explore folders, files and symbol neighborhoods using a graph or keyboard-accessible list.",
    "publisher": "oxytocin",
    "engine": "^0.2.1",
    "main": "dist/host.js",
    "activationEvents": [
      "onCommand:codeMap.open",
      "onCommand:codeMap.openReceipt",
      "onPanel:codeMap.view"
    ],
    "permissions": [
      "projects.read",
      "git.read",
      "code-map.read",
      "code-map.knowledge.read"
    ],
    "contributes": {
      "commands": [
        {
          "id": "codeMap.open",
          "title": "Code Map: Open"
        },
        {
          "id": "codeMap.openReceipt",
          "title": "Code Map: Open task context receipt"
        }
      ],
      "panels": [
        {
          "type": "codeMap.view",
          "title": "Code Map",
          "entry": "dist/views/map.html",
          "singleton": "project",
          "showInAddMenu": true
        }
      ]
    }
  },
  "dependencies": {
    "cytoscape": "^3.34.4"
  }
}
