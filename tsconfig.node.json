{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo",
    "types": ["node", "electron"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/pty-host/**/*",
    "src/workspace-host/**/*",
    "src/plugin-host/**/*",
    "src/connections-host/**/*",
    "src/shared/**/*"
  ]
}
