{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@oxytocin/plugin-api": ["./vendor/plugin-api/index.d.ts"],
      "@oxytocin/plugin-sdk": ["./vendor/plugin-sdk/index.ts"],
      "@oxytocin/plugin-sdk/react": ["./vendor/plugin-sdk/react.ts"]
    }
  },
  "include": ["src", "vendor"]
}
