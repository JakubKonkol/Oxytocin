{
  "name": "oxytocin-test-echo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "oxytocin": {
    "id": "test.echo",
    "displayName": "Echo (test)",
    "publisher": "oxytocin-tests",
    "engine": "^0.1.0",
    "activationEvents": [
      "onStartup"
    ],
    "contributes": {
      "commands": [
        {
          "id": "echo.hello",
          "title": "Echo: Hello"
        },
        {
          "id": "echo.projects",
          "title": "Echo: Projects"
        },
        {
          "id": "echo.terminals",
          "title": "Echo: Terminals"
        },
        {
          "id": "echo.git",
          "title": "Echo: Git"
        },
        {
          "id": "echo.store",
          "title": "Echo: Store"
        },
        {
          "id": "echo.setEnv",
          "title": "Echo: Set Environment"
        }
      ],
      "statusBarItems": [
        {
          "id": "echo.status",
          "alignment": "right",
          "priority": 10
        }
      ],
      "configuration": {
        "prefix": "echo",
        "properties": {
          "echo.greeting": {
            "type": "string",
            "default": "Hello"
          }
        }
      }
    },
    "main": "host.js",
    "permissions": [
      "projects.read",
      "terminals.read-metadata",
      "terminals.create",
      "terminals.env"
    ]
  },
  "type": "module"
}
