{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/tools.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "electron"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "packages/create-oxytocin-plugin/lib/*.d.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/shared/**/*",
    "src/main/**/*",
    "src/pty-host/**/*",
    "src/workspace-host/**/*",
    "src/plugin-host/**/*",
    "src/preload/**/*",
    "packages/*/index.d.ts",
    "packages/*/src/**/*",
    "plugins/*/src/host/**/*",
    "plugins/*/src/shared/**/*"
  ],
  "exclude": ["tests/fixtures/**"]
}
